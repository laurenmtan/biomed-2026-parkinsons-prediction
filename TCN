        epochs=EPOCHS, lr=LR, batch_size=BATCH_SIZE
    )

    print("\n[3/3] Reporting results...")
    print_results(results, all_probs, all_labels)
    plot_results(results, all_probs, all_labels, save_path="tcn_results.png")
